# Server config
PORT=3000
SESSION_SECRET=your-production-session-secret-minimum-32-chars
APP_BASE_URL=https://your-app-domain.com

# Discord
DISCORD_TOKEN=your-discord-bot-token

# Google Calendar OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-app-domain.com/auth/google/callback

# Supabase
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Groq LLM
GROQ_API_KEY=your-groq-api-key

# Encryption key for storing Google tokens (use strong 32+ character key)
ENCRYPTION_KEY=your-production-encryption-key-minimum-32-chars
